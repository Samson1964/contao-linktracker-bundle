{
    "name": "schachbulle/contao-linktracker-bundle",
    "type": "contao-bundle",
    "description": "Zählt Klicks auf Links und wertet sie im Backend aus.",
    "keywords": [
        "contao",
        "links",
        "tracking",
        "statistik"
    ],
    "homepage": "https://github.com/Samson1964/contao-linktracker-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "doctrine/dbal": "^3.3 || ^4.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/routing": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoLinktrackerBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoLinktrackerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoLinktrackerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-linktracker-bundle/issues",
        "source": "https://github.com/Samson1964/contao-linktracker-bundle"
    }
}
